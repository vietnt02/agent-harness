{
  "claude-bridge": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "{NODE} {HOME}/.gemini/config/claude-hook-bridge.cjs PreInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read_file|write_file|edit_file|view_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "{NODE} {HOME}/.gemini/config/claude-hook-bridge.cjs PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "{NODE} {HOME}/.gemini/config/claude-hook-bridge.cjs PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "{NODE} {HOME}/.gemini/config/claude-hook-bridge.cjs Stop",
        "timeout": 10
      }
    ]
  }
}