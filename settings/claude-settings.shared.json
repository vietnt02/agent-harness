{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/session-notes.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/worktree-after-release.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/rules-budget.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/worker-start-receipt.cjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/worker-start-receipt.cjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/answer-first.cjs\""
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/secret-file-guard.cjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/rules-budget.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/push-after-pr-guard.cjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/watch-guard.cjs\""
          },
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/tier-c-guard.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/main-checkout-guard.cjs\""
          },
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/dispatch-split-guard.cjs\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/agent-background-guard.cjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/session-notes.cjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/turn-guard.cjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/session-servers-guard.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/turn-guard.cjs\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{NODE}\" \"{HOME}/.claude/hooks/session-notes.cjs\""
          }
        ]
      }
    ]
  }
}
